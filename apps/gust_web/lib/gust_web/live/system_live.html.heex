<Layouts.app flash={@flash}>
  <div id="system-page" class="system-page">
    <section id="runtime-config" class="system-panel">
      <div class="system-panel__header">
        <h2 class="system-panel__title">Runtime</h2>
      </div>
      <dl class="system-runtime-grid">
        <div id="system-environment" class="system-stat">
          <dt class="system-label">Environment</dt>
          <dd class="system-value">{@system.environment}</dd>
        </div>
        <div id="system-role" class="system-stat">
          <dt class="system-label">GUST_ROLE</dt>
          <dd class="system-value">{@system.role}</dd>
        </div>
        <div id="system-run-dispatcher" class="system-stat">
          <dt class="system-label">Run dispatcher</dt>
          <dd class="system-value">{@system.run_dispatcher}</dd>
        </div>
        <div id="system-uptime" class="system-stat">
          <dt class="system-label">VM uptime</dt>
          <dd class="system-value">
            {format_uptime(@system.uptime_seconds)}
          </dd>
        </div>
        <div id="system-gust-version" class="system-stat">
          <dt class="system-label">Gust version</dt>
          <dd class="system-value">{@system.gust_version}</dd>
        </div>
        <div id="system-web-version" class="system-stat">
          <dt class="system-label">Gust Web version</dt>
          <dd class="system-value">{@system.gust_web_version}</dd>
        </div>
      </dl>
    </section>

    <section id="web-ui" class="system-panel">
      <div class="system-panel__header">
        <h2 class="system-panel__title">Web UI</h2>
      </div>
      <div class="system-panel__body">
        <div id="theme-preference">
          <div class="system-label">Color theme</div>
          <div class="mt-1 inline-flex items-center gap-2 text-base-content">
            <.icon name="hero-computer-desktop" class="size-5" />
            <span>System preference</span>
          </div>
        </div>
        <div class="mt-4">
          <p class="text-xs text-base-content/70">
            The theme follows your system preference and updates automatically when it changes.
          </p>
        </div>
      </div>
    </section>

    <section id="cluster-config" class="system-panel">
      <div class={["system-panel__header", "system-panel__header--split"]}>
        <h2 class="system-panel__title">Nodes connected</h2>
        <span id="connected-node-count" class="badge badge-outline">
          {length(@system.connected_nodes)}
        </span>
      </div>
      <div class="system-panel__body">
        <div>
          <div class="system-label">Current node</div>
          <div id="current-node" class="system-value">
            {@system.current_node}
          </div>
        </div>

        <p
          :if={@system.connected_nodes == []}
          id="connected-nodes-empty"
          class="system-empty"
        >
          No remote nodes are connected.
        </p>

        <ul :if={@system.connected_nodes != []} id="connected-nodes" class="system-node-list">
          <li :for={node <- @system.connected_nodes} class="system-node">
            {node}
          </li>
        </ul>
      </div>
    </section>

    <section id="dag-sources-panel" class="system-panel">
      <div class="system-panel__header">
        <h2 class="system-panel__title">DAG Sources</h2>
      </div>
      <div class="system-panel__body">
        <div :if={@dag_source_rows == []} class="system-empty">
          No DAG sources are configured.
        </div>

        <div
          :if={@dag_source_rows != []}
          class="overflow-hidden rounded-lg border border-base-content/15"
        >
          <table class="min-w-full table-fixed divide-y divide-base-content/15 text-left text-sm">
            <thead class="bg-base-200 text-base-content/80">
              <tr>
                <th class="w-32 px-3 py-3 font-semibold">Source ID</th>
                <th class="w-56 px-3 py-3 font-semibold">Source</th>
                <th class="w-28 px-3 py-3 font-semibold">Type</th>
                <th class="w-40 px-3 py-3 font-semibold">Path</th>
                <th class="w-24 px-3 py-3 font-semibold">Status</th>
                <th class="w-24 px-3 py-3 font-semibold text-right">Enabled</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-content/10 bg-base-100">
              <tr :for={source <- @dag_source_rows} class="even:bg-base-200/40">
                <td class="truncate px-3 py-3 font-medium text-base-content">{source.id}</td>
                <td class="truncate px-3 py-3 text-base-content/75">{source.source}</td>
                <td class="truncate px-3 py-3 text-base-content/75">{source.type}</td>
                <td class="truncate px-3 py-3 text-base-content/75">{source.path}</td>
                <td class="px-3 py-3">
                  <span class={[
                    "inline-flex rounded-full px-2 py-1 text-xs font-medium",
                    source.status == :running && "bg-success/15 text-success",
                    source.status == :paused && "bg-warning/15 text-warning",
                    source.status == :stopped && "bg-base-300 text-base-content/75",
                    source.status == :unavailable && "bg-base-200 text-base-content/60"
                  ]}>
                    {case source.status do
                      :running -> "Running"
                      :paused -> "Paused"
                      :stopped -> "Stopped"
                      _ -> "Unavailable"
                    end}
                  </span>
                </td>
                <td class="px-3 py-3 text-right">
                  <label
                    class="inline-flex cursor-pointer items-center justify-end gap-2"
                    for={"dag-source-toggle-#{source.id}"}
                  >
                    <input
                      id={"dag-source-toggle-#{source.id}"}
                      type="checkbox"
                      checked={source.status == :running}
                      disabled={source.status == :unavailable}
                      phx-click="toggle_dag_source_status"
                      phx-value-id={source.id}
                      class="toggle toggle-success"
                      aria-label={"Enable or disable #{source.id}"}
                    />
                  </label>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</Layouts.app>
